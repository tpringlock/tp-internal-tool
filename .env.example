# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API).

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser. Used by admin server actions
# (creating users, streaming files) to bypass RLS after an app-layer check.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build password-reset / share links. In dev this is
# http://localhost:3000; on Vercel set it to your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MISA ACT Open API (AMIS Kế toán). Server-only — NEVER expose to the browser.
# APP_ID is issued by MISA for the partner application.
MISA_APP_ID=your-misa-app-id
# Optional. Defaults to https://actapp.misa.vn when unset.
MISA_API_URL=https://actapp.misa.vn
# Credentials used by the automated data sync to obtain a token (no UI input).
# access_code is issued by MISA; org_company_code identifies the company/tenant.
MISA_ACCESS_CODE=your-misa-access-code
MISA_ORG_COMPANY_CODE=your-org-company-code
# Shared secret protecting the Vercel Cron sync endpoint (GET /api/misa/sync).
# Required only once you enable the cron trigger; use a long random string.
CRON_SECRET=your-cron-secret
